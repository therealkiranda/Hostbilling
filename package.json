{
  "name": "hostbilling",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source hosting commerce and billing platform",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check",
    "dev:api": "pnpm --filter @hostbilling/api dev",
    "build": "pnpm --filter @hostbilling/api build",
    "test": "pnpm --filter @hostbilling/api test",
    "typecheck": "pnpm --filter @hostbilling/api typecheck",
    "db:generate": "pnpm --filter @hostbilling/database db:generate",
    "db:validate": "pnpm --filter @hostbilling/database db:validate",
    "db:migrate:dev": "pnpm --filter @hostbilling/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @hostbilling/database db:migrate:deploy",
    "db:studio": "pnpm --filter @hostbilling/database db:studio"
  },
  "devDependencies": {
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
