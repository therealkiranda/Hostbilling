generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  BILLING
  SUPPORT
}

enum HostingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_WALLET
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

model Tenant {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  slug           String             @unique
  status         TenantStatus       @default(ACTIVE)
  memberships    TenantMembership[]
  hostingPlans   HostingPlan[]
  customers      Customer[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  payments       Payment[]
  invoiceCounter Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  passwordHash    String
  name            String?
  status          UserStatus         @default(ACTIVE)
  emailVerifiedAt DateTime?
  memberships     TenantMembership[]
  sessions        AuthSession[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model TenantMembership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

model HostingPlan {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  slug               String
  name               String
  description        String?           @db.Text
  status             HostingPlanStatus @default(DRAFT)
  priceMinorUnits    Int
  setupFeeMinorUnits Int               @default(0)
  currency           String            @db.VarChar(3)
  billingInterval    BillingInterval
  intervalCount      Int               @default(1)
  diskQuotaMb        Int
  bandwidthQuotaMb   Int
  maxDomains         Int               @default(1)
  maxEmailAccounts   Int               @default(0)
  maxDatabases       Int               @default(0)
  maxFtpAccounts     Int               @default(0)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscriptions      Subscription[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  name          String
  email         String?
  phone         String?
  companyName   String?
  notes         String?        @db.Text
  status        CustomerStatus @default(ACTIVE)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, name])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  customerId         String             @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(PENDING)
  priceMinorUnits    Int
  setupFeeMinorUnits Int
  currency           String             @db.VarChar(3)
  billingInterval    BillingInterval
  intervalCount      Int
  startedAt          DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  billedPeriods      Int                @default(0)
  suspendedAt        DateTime?
  cancelledAt        DateTime?
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer           Customer           @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  plan               HostingPlan        @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  invoices           Invoice[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, planId])
  @@index([status, currentPeriodEnd])
}

model Invoice {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  customerId         String            @db.Uuid
  subscriptionId     String            @db.Uuid
  number             String
  status             InvoiceStatus     @default(OPEN)
  currency           String            @db.VarChar(3)
  subtotalMinorUnits Int
  totalMinorUnits    Int
  issuedAt           DateTime
  dueAt              DateTime
  periodStart        DateTime
  periodEnd          DateTime
  periodKey          String?
  paidAt             DateTime?
  voidedAt           DateTime?
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer           Customer          @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  subscription       Subscription      @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  lineItems          InvoiceLineItem[]
  payments           Payment[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@unique([tenantId, periodKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, subscriptionId])
}

model InvoiceLineItem {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  invoiceId            String   @db.Uuid
  description          String
  quantity             Int
  unitAmountMinorUnits Int
  amountMinorUnits     Int
  invoice              Invoice  @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  createdAt            DateTime @default(now())

  @@index([tenantId, invoiceId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  invoiceId        String        @db.Uuid
  customerId       String        @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(COMPLETED)
  amountMinorUnits Int
  currency         String        @db.VarChar(3)
  reference        String?
  note             String?       @db.Text
  paidAt           DateTime
  activeKey        String?
  recordedByUserId String        @db.Uuid
  reversedAt       DateTime?
  reversedByUserId String?       @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoice          Invoice       @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  customer         Customer      @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, activeKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, invoiceId])
  @@index([tenantId, customerId])
}
