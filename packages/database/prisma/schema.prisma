generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  BILLING
  SUPPORT
}

enum HostingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String             @unique
  status       TenantStatus       @default(ACTIVE)
  memberships  TenantMembership[]
  hostingPlans HostingPlan[]
  customers    Customer[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  passwordHash    String
  name            String?
  status          UserStatus         @default(ACTIVE)
  emailVerifiedAt DateTime?
  memberships     TenantMembership[]
  sessions        AuthSession[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model TenantMembership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

model HostingPlan {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  slug               String
  name               String
  description        String?           @db.Text
  status             HostingPlanStatus @default(DRAFT)
  priceMinorUnits    Int
  setupFeeMinorUnits Int               @default(0)
  currency           String            @db.VarChar(3)
  billingInterval    BillingInterval
  intervalCount      Int               @default(1)
  diskQuotaMb        Int
  bandwidthQuotaMb   Int
  maxDomains         Int               @default(1)
  maxEmailAccounts   Int               @default(0)
  maxDatabases       Int               @default(0)
  maxFtpAccounts     Int               @default(0)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Customer {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  email       String?
  phone       String?
  companyName String?
  notes       String?        @db.Text
  status      CustomerStatus @default(ACTIVE)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, name])
}
