# Copy this file to .env for local development.
# Never commit real credentials or production secrets.

NODE_ENV=development
HOSTBILLING_APP_URL=http://localhost:3000
HOSTBILLING_API_URL=http://localhost:4000

# Local development services
DATABASE_URL=postgresql://hostbilling:hostbilling@localhost:5432/hostbilling
REDIS_URL=redis://localhost:6379

# Generate a unique, high-entropy secret before running the application.
# Do not use this placeholder value in a real environment.
SESSION_SECRET=replace-with-a-long-random-secret
