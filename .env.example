# Copy this file to .env for local development.
# Never commit real credentials or production secrets.

NODE_ENV=development
HOSTBILLING_APP_URL=http://localhost:3000
HOSTBILLING_API_URL=http://localhost:4000

# Local development services
DATABASE_URL=postgresql://hostbilling:hostbilling@localhost:5432/hostbilling?schema=public
REDIS_URL=redis://localhost:6379

# Generate a unique, high-entropy secret (at least 32 random bytes).
# Do not use this placeholder value in a real environment.
JWT_SECRET=replace-with-at-least-32-random-bytes

# PostgreSQL container credentials (local development only)
POSTGRES_DB=hostbilling
POSTGRES_USER=hostbilling
POSTGRES_PASSWORD=hostbilling
